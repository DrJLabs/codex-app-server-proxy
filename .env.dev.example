#
# Dev stack environment file (used by `npm run dev:stack:*`).
# Loaded by `scripts/dev-stack.sh` as `--env-file .env.dev`.
#

# Required
PROXY_API_KEY=your-dev-key
DEV_DOMAIN=codex-dev.example.com
PROXY_CORS_ALLOWED_ORIGINS=https://codex-dev.example.com,https://obsidian.md,app://obsidian.md,capacitor://localhost,http://localhost,https://localhost

# Optional: override dev port (compose default is 18010)
# DEV_PORT=18010

# Recommended
PROXY_ENV=dev
PROXY_USE_APP_SERVER=true

# Let edge (Traefik/Cloudflare) handle CORS in DEV (parity with prod)
PROXY_ENABLE_CORS=false

# Dev stack: force Codex HOME to project-local .codev (mounted into the container)
CODEX_HOME=.codev

# Runtime model selection
# Leave unset to use the default (gpt-5). The dev stack already normalizes
# advertised codev-5-* IDs to gpt-5 with the matching reasoning effort.
# Explicit overrides like gpt-5-minimal are not supported by the dev key and
# will result in 400 "Unsupported model" responses from the Codex CLI.
# CODEX_MODEL=gpt-5.2

# DEV-only safeguard: early finalize non-stream if backend is slow (ms; 0=disabled)
# Avoids Cloudflare 524 by returning finish_reason:"length" before the 100s no-bytes window
# Prefer PROXY_NONSTREAM_TRUNCATE_AFTER_MS; PROXY_DEV_TRUNCATE_AFTER_MS is deprecated.
# PROXY_NONSTREAM_TRUNCATE_AFTER_MS=0
# PROXY_DEV_TRUNCATE_AFTER_MS=0

# Codex CLI selection (dev stack)
# - Default in compose.dev.stack.yml is CODEX_BIN=codex (real Codex CLI; requires ~/.cargo/bin/codex mounted)
# - To use the lightweight proto shim for offline tests, set:
# CODEX_BIN=/app/scripts/fake-codex-proto.js

# Internal tools surface (recommended: keep disabled).
# PROXY_DISABLE_INTERNAL_TOOLS=true
# PROXY_DISABLE_INTERNAL_TOOLS_CONFIG=true
# PROXY_DISABLE_INTERNAL_TOOLS_PROMPT=true
# PROXY_ENABLE_INTERNAL_TOOLS_SHIM=false
# PROXY_ENABLE_WEB_SEARCH_REQUEST=false

# Observability (dev defaults: proto logging enabled, tracing required)
# PROXY_LOG_PROTO=true
# PROXY_TRACE_REQUIRED=true
# PROXY_LOG_REDACT=true
# PROXY_TRACE_REDACT=true
# PROXY_TRACE_BODY_LIMIT=4096
# PROTO_LOG_PATH=/home/node/.codex/proto-events.ndjson
# TOKEN_LOG_PATH=/tmp/codex-usage.ndjson
# SANITIZER_LOG_BASE_DIR=/tmp
# SANITIZER_LOG_PATH=codex-sanitizer.ndjson

# Model naming in dev vs prod
# - Dev advertises codev-5 and codev-5-{low,medium,high,minimal}
# - Prod advertises codex-5 and codex-5-{low,medium,high,minimal}
# Some clients validate against /v1/models and will reject the wrong prefix.
